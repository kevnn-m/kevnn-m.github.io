---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('writing', (p) => import.meta.env.DEV || !p.data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = post.data.date.toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Base title={post.data.title} description={post.data.summary}>
  <article class="wrap post">
    <div class="page-head">
      <p><a href="/writing/">← Writing</a></p>
      <h1>{post.data.title}</h1>
      <p><time datetime={post.data.date.toISOString()}>{date}</time></p>
    </div>
    {post.data.cover && <Image class="cover" src={post.data.cover} alt="" widths={[720, 1440]} sizes="(max-width: 880px) 100vw, 832px" />}
    <div class="prose section"><Content /></div>
  </article>
</Base>

<style>
  .post { max-width: 720px; }
  .cover { width: 100%; border-radius: var(--radius); margin-top: 24px; }
</style>
