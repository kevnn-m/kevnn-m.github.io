  scholar:
    'M12 3 1 9l4 2.2V17c0 2.2 3.1 4 7 4s7-1.8 7-4v-5.8l2-1.1V17h2V9L12 3zm5 14c0 .9-2 2-5 2s-5-1.1-5-2v-4.7l5 2.7 5-2.7V17z',
  linkedin:
    'M4.98 3.5A2.5 2.5 0 1 1 5 8.5a2.5 2.5 0 0 1-.02-5zM3 9h4v12H3V9zm7 0h3.8v1.7h.1c.5-1 1.8-2 3.7-2 4 0 4.7 2.6 4.7 6V21h-4v-5.5c0-1.3 0-3-1.9-3s-2.2 1.4-2.2 2.9V21h-4V9z',
  substack: 'M4 3h16v2.4H4V3zm0 4.3h16v2.4H4V7.3zm0 4.3h16V21l-8-4.5L4 21v-9.4z',
  cv: 'M6 2h8l6 6v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1zm7 1.5V9h5.5L13 3.5zM8 12v1.6h8V12H8zm0 3.4V17h8v-1.6H8z',
};
const d = PATHS[name];
---
{d && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d={d} />
  </svg>
)}
