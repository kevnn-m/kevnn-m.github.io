---
// Illustrated banner: a painted landscape with grass in the wind (code-drawn
// layers) and the character illustration (src/scene/art/vignette.svg).
// The objects in the illustration are real links; the cat is a button.
import vignetteSvg from '../scene/art/vignette.svg?raw';
import { SITE } from '../site';

const catName = SITE.catName || 'Cat';
const svg = vignetteSvg.replace('aria-label="Cat"', `aria-label="${catName}"`);
---
<section class="scene" data-scene aria-label="Illustration: Kevin reading in the grass with his cat">
  <canvas class="layer l-sky" aria-hidden="true"></canvas>
  <canvas class="layer l-far" aria-hidden="true"></canvas>
  <canvas class="layer l-mid" aria-hidden="true"></canvas>
  <div class="layer l-plane">
    <canvas class="l-near" aria-hidden="true"></canvas>
    <canvas class="l-field" aria-hidden="true"></canvas>
    <div class="vignette" set:html={svg} />
    <canvas class="l-front" aria-hidden="true"></canvas>
  </div>
  <canvas class="l-fx" aria-hidden="true"></canvas>

  <div class="scene-label" hidden aria-hidden="true"></div>
  <div class="cat-bubble" hidden aria-hidden="true">mrrp</div>
  <div class="cat-pop" id="cat-pop" role="dialog" aria-label={`${catName} photos`} hidden>
    <a href="/cat/">See {SITE.catName ? `${SITE.catName}'s` : 'cat'} photos →</a>
    <button type="button" class="cat-close" aria-label="Close">×</button>
  </div>
</section>

<script>
  import { mountScene } from '../scene/scene';
  for (const el of document.querySelectorAll<HTMLElement>('[data-scene]')) mountScene(el);
</script>

<style>
  .scene {
    position: relative; overflow: hidden;
    height: clamp(380px, 64vh, 760px);
    /* shown before the script runs, or without JavaScript */
    background: linear-gradient(160deg, #5d9fe0, #cfe8f5 45%, #8cc65a 45%, #5c9636);
    border-bottom: 1px solid var(--line);
  }
  @media (prefers-color-scheme: dark) {
    .scene { background: linear-gradient(160deg, #081130, #24406e 45%, #24492c 45%, #16321d); }
  }
  /* Layers are 21px larger than the scene on each side (room for parallax; see MARGIN in scene.ts). */
  .layer {
    position: absolute; top: -21px; left: -21px;
    width: calc(100% + 42px); height: calc(100% + 42px);
    will-change: transform;
  }
  /* The script sets each canvas to an exact multiple of the art-pixel size. */
  .l-plane > canvas, .l-fx { position: absolute; top: 0; left: 0; }
  canvas { display: block; pointer-events: none; image-rendering: pixelated; image-rendering: crisp-edges; }

  /* The script sets the exact place and size; this is the spot before it runs. */
  .vignette { position: absolute; left: 20%; bottom: 8%; width: 56%; pointer-events: none; }
  .vignette :global(svg) { position: relative; display: block; width: 100%; height: auto; pointer-events: none; overflow: visible; }
  .vignette :global(svg a), .vignette :global(svg #cat) { pointer-events: auto; cursor: pointer; }
  /* Once the script draws the pixel copy, the SVG stays only for links, focus and
     hover, and the script draws the focus outline. Without the script, the site's
     normal focus ring shows on the SVG. */
  .vignette[data-raster] :global(svg) { opacity: 0; }
  .vignette[data-raster] :global(svg :is(a, #cat)) { outline: none; }
  /* With JavaScript, keep the drawing hidden until the scene has placed it
     (shown anyway after 3 s, in case the script fails). */
  :global(.js) .scene:not([data-ready]) .vignette { visibility: hidden; animation: vg-show 0s 3s forwards; }
  @keyframes vg-show { to { visibility: visible; } }
  .vignette :global(.vignette-art) { position: absolute; image-rendering: pixelated; image-rendering: crisp-edges; }
  @media (prefers-color-scheme: dark) {
    .vignette :global(:is(svg, .vignette-art)) { filter: brightness(0.6) saturate(0.85); }
  }

  /* Labels and popups in a pixel-game style, to match the art. */
  .scene-label, .cat-bubble, .cat-pop {
    position: absolute; z-index: 5; transform: translate(-50%, -100%);
    font: 600 0.8rem/1.3 ui-monospace, SFMono-Regular, Menlo, monospace; color: #2b2420;
    background: #fffdf2; border: 3px solid #2b2420; border-radius: 0;
    box-shadow: 3px 3px 0 #2b2420;
  }
  .scene-label { padding: 3px 8px; pointer-events: none; white-space: nowrap; }
  .cat-bubble { padding: 4px 10px; font-style: italic; }
  .cat-pop { display: flex; align-items: center; gap: 8px; padding: 6px 6px 6px 12px; white-space: nowrap; }
  .cat-pop a { color: #2f5fa7; text-decoration: underline; text-underline-offset: 3px; }
  .cat-close {
    border: 0; background: none; font-size: 1.2rem; line-height: 1; cursor: pointer;
    color: #5f6670; padding: 2px 6px; border-radius: 6px;
  }
  .cat-close:hover { background: #f1ede2; }
  [hidden] { display: none !important; }
</style>
