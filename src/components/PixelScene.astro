---
// Pixel-art banner. The canvas is decoration; each object has a real link
// on top of it, so it works with a mouse, a keyboard, and screen readers.
// To add an object: add a sprite in src/scene/sprites.ts (and to SPRITES),
// then add a link here with data-sprite set to its name.
const OBJECTS = [
  { sprite: 'papers', label: 'Publications', href: '/publications/' },
  { sprite: 'person', label: 'About me', href: '#about' },
  { sprite: 'camera', label: 'Photography', href: '/photography/' },
];
---
<div class="scene" data-scene>
  <canvas aria-hidden="true"></canvas>
  {OBJECTS.map((o) => (
    <a href={o.href} data-sprite={o.sprite}><span class="label">{o.label}</span></a>
  ))}
</div>

<script>
  import { mountScene } from '../scene/scene';
  for (const el of document.querySelectorAll<HTMLElement>('[data-scene]')) mountScene(el);
</script>

<style>
  .scene {
    position: relative; overflow: hidden;
    height: 240px; /* the script sets the exact height */
    /* shown before the script runs, or without JavaScript */
    background: linear-gradient(#a3d1f2 0 70%, #5a9c41 70%);
    border-bottom: 1px solid var(--line);
  }
  @media (max-width: 999px) { .scene { height: 192px; } }
  @media (max-width: 559px) { .scene { height: 144px; } }
  @media (prefers-color-scheme: dark) {
    .scene { background: linear-gradient(#121e3e 0 70%, #244529 70%); }
  }
  canvas { display: block; image-rendering: pixelated; }

  /* links are placed over the objects by the script */
  a { position: absolute; display: none; border-radius: 4px; }
  .scene[data-ready] a { display: block; }
  a:focus-visible { outline: 2px solid #fff; outline-offset: 0; }

  .label {
    position: absolute; left: 50%; bottom: 100%; transform: translate(-50%, -6px);
    padding: 3px 8px; white-space: nowrap;
    font: 600 12px/1.2 ui-monospace, SFMono-Regular, Menlo, monospace;
    color: #1f2328; background: #fffdf2; border: 2px solid #1f2328;
    box-shadow: 2px 2px 0 #1f2328;
    opacity: 0; pointer-events: none; transition: opacity 0.12s;
  }
  a:hover .label, a:focus-visible .label { opacity: 1; }
</style>
