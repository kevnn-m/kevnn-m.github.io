---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import PubMeta from './PubMeta.astro';

interface Props {
  pub: CollectionEntry<'publications'>;
  hasProject?: boolean;
}
const { pub, hasProject = false } = Astro.props;
const p = pub.data;
const projectHref = hasProject ? `/publications/${pub.id}/` : undefined;
const titleHref = projectHref ?? p.links.paper ?? p.links.arxiv ?? p.links.pdf;
const external = !projectHref;
---
<article class:list={['pub', { nofig: !p.figure }]} data-selected={p.selected ? 'true' : 'false'}>
  {p.figure && (
    <div class="fig">
      <a href={titleHref} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined} tabindex="-1" aria-hidden="true">
        <Image src={p.figure} alt={p.figureAlt ?? ''} widths={[240, 480]} sizes="(max-width: 680px) 100vw, 220px" />
      </a>
      {p.figureCredit && <small class="credit">{p.figureCredit}</small>}
    </div>
  )}
  <div>
    <h3>{titleHref ? <a href={titleHref} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>{p.title}</a> : p.title}</h3>
    <PubMeta pub={pub} projectHref={projectHref}>
      <p class="tldr"><strong>TL;DR</strong> {p.tldr}</p>
    </PubMeta>
  </div>
</article>

<style>
  .pub {
    display: grid; grid-template-columns: 220px 1fr; gap: 22px;
    padding: 18px; margin-bottom: 18px;
    background: var(--surface); border: 1px solid var(--line); border-left: 6px solid var(--pub-1);
    border-radius: var(--radius); box-shadow: var(--shadow);
  }
  :global(.publist) .pub:nth-of-type(4n + 2) { border-left-color: var(--pub-2); }
  :global(.publist) .pub:nth-of-type(4n + 3) { border-left-color: var(--pub-3); }
  :global(.publist) .pub:nth-of-type(4n + 4) { border-left-color: var(--pub-4); }
  .pub.nofig { grid-template-columns: 1fr; }

  .fig { align-self: start; }
  .fig a { display: block; }
  .fig :global(img) {
    width: 100%; aspect-ratio: 3 / 2; object-fit: contain;
    background: #fff; border: 1px solid var(--line); border-radius: 8px;
  }

  .credit { display: block; margin-top: 4px; font-size: 0.72rem; line-height: 1.3; color: var(--muted); }

  h3 { font-size: 1.08rem; }
  h3 a { color: var(--text); }
  h3 a:hover { color: var(--accent); }
  .tldr { font-size: 0.95rem; margin: 0 0 6px; }

  @media (max-width: 680px) {
    .pub { grid-template-columns: 1fr; gap: 14px; }
  }
</style>
